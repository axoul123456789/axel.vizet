<Window x:Class="axel.vizet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:axel.vizet"
        mc:Ignorable="d"
        Title="Calculatrice"
        Height="550"
        Width="450"
        MinHeight="450"
        MinWidth="350"
        WindowStartupLocation="CenterScreen">

    <Grid Background="#190b28">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Resources>

            <!-- Style de base : les chiffres (violet foncé) -->
            <Style TargetType="{x:Type Button}">
                <Setter Property="Margin" Value="10"/>
                <Setter Property="FontSize" Value="30"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="#3d1e6d"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>

                <Style.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="15"/>
                    </Style>
                </Style.Resources>
            </Style>

            <!-- Boutons + - * / (violet claire) -->
            <Style x:Key="StyleOperateur" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#6969b3"/>
            </Style>

            <!-- Bouton CLR (jaune, texte foncé pour bien lire) -->
            <Style x:Key="StyleClear" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#ffbe0b"/>
                <Setter Property="Foreground" Value="#190b28"/>
            </Style>

            <!-- Bouton = (bleu électrique) -->
            <Style x:Key="StyleEgal" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#00bbf9"/>
                <Setter Property="Foreground" Value="#190b28"/>
            </Style>

            <!-- Boutons sin, cos, racine, carré (violet) -->
            <Style x:Key="StyleMath" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="#420039"/>
            </Style>

        </Grid.Resources>

        <!-- Écran -->
        <TextBox Grid.Row="0"
                 Grid.ColumnSpan="4"
                 Margin="8"
                 Padding="10,0"
                 FontSize="50"
                 TextAlignment="Right"
                 VerticalContentAlignment="Center"
                 Background="#0f0518"
                 Foreground="#00f5d4"
                 BorderThickness="0"
                 IsReadOnly="True"
                 Text="0"
                 Name="TB_Display"/>

        <!-- Ligne 1 -->
        <Button Grid.Row="1" Grid.Column="0" Name="BTN_1" Content="1" Click="BTN_1_Click"/>
        <Button Grid.Row="1" Grid.Column="1" Name="BTN_2" Content="2" Click="BTN_2_Click"/>
        <Button Grid.Row="1" Grid.Column="2" Name="BTN_3" Content="3" Click="BTN_3_Click"/>
        <Button Grid.Row="1" Grid.Column="3" Name="BTN_Plus" Style="{StaticResource StyleOperateur}" Content="+" Click="BTN_Plus_Click"/>

        <!-- Ligne 2 -->
        <Button Grid.Row="2" Grid.Column="0" Name="BTN_4" Content="4" Click="BTN_4_Click"/>
        <Button Grid.Row="2" Grid.Column="1" Name="BTN_5" Content="5" Click="BTN_5_Click"/>
        <Button Grid.Row="2" Grid.Column="2" Name="BTN_6" Content="6" Click="BTN_6_Click"/>
        <Button Grid.Row="2" Grid.Column="3" Name="BTN_Moins" Style="{StaticResource StyleOperateur}" Content="-" Click="BTN_Moins_Click"/>

        <!-- Ligne 3 -->
        <Button Grid.Row="3" Grid.Column="0" Name="BTN_7" Content="7" Click="BTN_7_Click"/>
        <Button Grid.Row="3" Grid.Column="1" Name="BTN_8" Content="8" Click="BTN_8_Click"/>
        <Button Grid.Row="3" Grid.Column="2" Name="BTN_9" Content="9" Click="BTN_9_Click"/>
        <Button Grid.Row="3" Grid.Column="3" Name="BTN_Fois" Style="{StaticResource StyleOperateur}" Content="*" Click="BTN_Fois_Click"/>

        <!-- Ligne 4 -->
        <Button Grid.Row="4" Grid.Column="0" Name="BTN_0" Content="0" Click="BTN_0_Click"/>
        <Button Grid.Row="4" Grid.Column="1" Name="BTN_CLR" Style="{StaticResource StyleClear}" Content="CLR" Click="BTN_CLR_Click"/>
        <Button Grid.Row="4" Grid.Column="2" Name="BTN_egale" Style="{StaticResource StyleEgal}" Content="=" Click="BTN_egale_Click"/>
        <Button Grid.Row="4" Grid.Column="3" Name="BTN_DIV" Style="{StaticResource StyleOperateur}" Content="/" Click="BTN_DIV_Click"/>

        <!-- Ligne 5 : fonctions mathématiques -->
        <Button Grid.Row="5" Grid.Column="0" Name="Btn_puissance" Style="{StaticResource StyleMath}" Content="x²" Click="Btn_puissance_Click"/>
        <Button Grid.Row="5" Grid.Column="1" Name="Btn_racine_carre" Style="{StaticResource StyleMath}" Content="√" Click="Btn_racine_carre_Click"/>
        <Button Grid.Row="5" Grid.Column="2" Name="Btn_cos" Style="{StaticResource StyleMath}" Content="cos" Click="Btn_cos_Click"/>
        <Button Grid.Row="5" Grid.Column="3" Name="Btn_sin" Style="{StaticResource StyleMath}" Content="sin" Click="Btn_sin_Click"/>
    </Grid>
</Window>